# Development-only values. Do not use these credentials outside local development.
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver

POSTGRES_DB=dualsign_dev
POSTGRES_USER=dualsign_dev
POSTGRES_PASSWORD=development-postgres-password
POSTGRES_HOST_PORT=5432

REDIS_PASSWORD=development-redis-password
REDIS_HOST_PORT=6379

MINIO_ROOT_USER=development-minio
MINIO_ROOT_PASSWORD=development-minio-password
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

NGINX_HOST_PORT=8080
NEXT_PUBLIC_API_BASE_URL=/api
# Stripe test-mode placeholders only. Leave blank until a local test account is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PLUS_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
