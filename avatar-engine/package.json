{
  "name": "@dualsign/avatar-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.md\"",
    "test": "node --input-type=module -e \"import('@dualsign/avatar-engine')\" && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@babylonjs/core": "8.32.0",
    "@babylonjs/loaders": "8.32.0"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "prettier": "3.5.3",
    "typescript": "5.8.2"
  }
}
